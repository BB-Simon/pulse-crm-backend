# App
PORT=3000
# Base URL of the frontend app, used to build links in emails (e.g. invite accept links)
FRONTEND_URL="http://localhost:5173"

# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://pulsecrm:pulsecrm@localhost:5433/pulsecrm?schema=public"

# Auth
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# In seconds
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Redis (see docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Stripe (see scripts/stripe-setup-plans.ts)
STRIPE_SECRET_KEY="sk_test_..."
# Populated by `npm run stripe:setup-plans`
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""
# POST /billing/webhook signing secret. For local dev, run:
#   stripe listen --forward-to localhost:3000/api/v1/billing/webhook
# and copy the "whsec_..." secret it prints. In production, copy it from the
# webhook endpoint's settings in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."
