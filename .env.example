# App
PORT=3000
# Base URL of the frontend app, used to build links in emails (e.g. invite accept links)
FRONTEND_URL="http://localhost:5173"

# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://pulsecrm:pulsecrm@localhost:5433/pulsecrm?schema=public"

# Auth
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# In seconds
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Redis (see docker-compose.yml)
REDIS_URL="redis://localhost:6379"
