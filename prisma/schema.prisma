// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  REP
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// ─────────────────────────────────────────────
// Tenant root
// ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  pipelineStages PipelineStage[]
  activities     Activity[]
  tasks          Task[]
  invites        Invite[]
}

// ─────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role     @default(REP)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Reverse relations — records this user owns / is responsible for
  ownedContacts    Contact[]  @relation("ContactOwner")
  ownedDeals       Deal[]     @relation("DealOwner")
  loggedActivities Activity[] @relation("ActivityAuthor")
  assignedTasks    Task[]     @relation("TaskAssignee")
  sentInvites      Invite[]   @relation("InviteSender")

  @@index([organizationId, role])
}

// ─────────────────────────────────────────────
// Team invites
// ─────────────────────────────────────────────

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role         @default(REP)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, status])
}

// ─────────────────────────────────────────────
// Companies & Contacts
// ─────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]

  @@index([organizationId, name])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  companyId      String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, email])
  @@index([organizationId, createdAt])
  @@index([tags], type: Gin)
}

// ─────────────────────────────────────────────
// Pipeline & Deals
// ─────────────────────────────────────────────

model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, order])
  @@index([organizationId])
}

model Deal {
  id                String     @id @default(cuid())
  organizationId    String
  ownerId           String
  contactId         String
  companyId         String?
  pipelineStageId   String
  title             String
  value             Decimal    @db.Decimal(12, 2)
  status            DealStatus @default(OPEN)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)

  activities Activity[]
  tasks      Task[]

  @@index([organizationId, ownerId])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, status])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, contactId])
}

// ─────────────────────────────────────────────
// Activities
// ─────────────────────────────────────────────

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  contactId      String?
  dealId         String?
  type           ActivityType
  content        String
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ActivityAuthor", fields: [userId], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId])
  @@index([organizationId, dealId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, userId])
}

// ─────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────

model Task {
  id             String    @id @default(cuid())
  organizationId String
  assigneeId     String
  contactId      String?
  dealId         String?
  title          String
  description    String?
  dueDate        DateTime
  completed      Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, assigneeId])
  @@index([organizationId, dueDate])
  @@index([organizationId, completed])
  @@index([organizationId, contactId])
  @@index([organizationId, dealId])
}
