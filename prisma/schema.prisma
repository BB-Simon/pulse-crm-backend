// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  REP
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationType {
  DEAL_STAGE_CHANGED
  TASK_OVERDUE
  LEAD_ASSIGNED
}

enum Plan {
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

// ─────────────────────────────────────────────
// Tenant root
// ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  pipelineStages PipelineStage[]
  activities     Activity[]
  tasks          Task[]
  invites        Invite[]
  subscription   Subscription?
  notifications  Notification[]
  webhooks       Webhook[]
  apiKeys        ApiKey[]

  @@map("organizations")
}

// ─────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  role           Role     @default(REP)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Reverse relations — records this user owns / is responsible for
  ownedContacts    Contact[]      @relation("ContactOwner")
  ownedDeals       Deal[]         @relation("DealOwner")
  loggedActivities Activity[]     @relation("ActivityAuthor")
  assignedTasks    Task[]         @relation("TaskAssignee")
  sentInvites      Invite[]       @relation("InviteSender")
  notifications    Notification[]
  createdWebhooks  Webhook[]      @relation("WebhookCreator")
  createdApiKeys   ApiKey[]       @relation("ApiKeyCreator")

  @@index([organizationId, role])
  @@map("users")
}

// ─────────────────────────────────────────────
// Team invites
// ─────────────────────────────────────────────

model Invite {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  email          String
  role           Role         @default(REP)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedById    String       @map("invited_by_id")
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("invites")
}

// ─────────────────────────────────────────────
// Outbound webhooks
// ─────────────────────────────────────────────

model Webhook {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  targetUrl        String   @map("target_url")
  /// HMAC signing secret. Generated server-side; returned to the client only
  /// once, in the create response — never again after that.
  secret           String
  subscribedEvents String[] @default([]) @map("subscribed_events")
  isActive         Boolean  @default(true) @map("is_active")
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Restrict)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([subscribedEvents], type: Gin)
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String                @map("webhook_id")
  eventType    String                @map("event_type")
  status       WebhookDeliveryStatus
  responseCode Int?                  @map("response_code")
  error        String?
  /// 1-based attempt number (retries increment this)
  attempt      Int                   @default(1)
  deliveredAt  DateTime              @default(now()) @map("delivered_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, deliveredAt])
  @@map("webhook_deliveries")
}

// ─────────────────────────────────────────────
// Public API keys
// ─────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  /// Safe-to-display prefix of the raw key (e.g. "pcrm_3f9a1c78..."). The
  /// full key is shown only once, at creation, and cannot be recovered.
  keyPreview     String    @map("key_preview")
  /// SHA-256 hash of the full raw key, used to authenticate requests.
  hashedKey      String    @unique @map("hashed_key")
  createdById    String    @map("created_by_id")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────
// In-app notifications
// ─────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  type           NotificationType
  title          String
  body           String
  /// Relative frontend path this notification should link to, e.g. /deals/:id
  link           String?
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// Billing / Subscriptions
// ─────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique @map("organization_id")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  seatLimit            Int                @map("seat_limit")
  contactLimit         Int                @map("contact_limit")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// Companies & Contacts
// ─────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  domain         String?
  industry       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]

  @@index([organizationId, name])
  @@map("companies")
}

model Contact {
  id                 String    @id @default(cuid())
  organizationId     String    @map("organization_id")
  ownerId            String    @map("owner_id")
  companyId          String?   @map("company_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String?
  phone              String?
  tags               String[]  @default([])
  /// Cached AI lead score (0-100); see LeadScoringService. Null until first scored.
  leadScore          Int?      @map("lead_score")
  leadScoreRationale String?   @map("lead_score_rationale")
  leadScoredAt       DateTime? @map("lead_scored_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, email])
  @@index([organizationId, createdAt])
  @@index([tags], type: Gin)
  @@map("contacts")
}

// ─────────────────────────────────────────────
// Pipeline & Deals
// ─────────────────────────────────────────────

model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  order          Int
  isWon          Boolean  @default(false) @map("is_won")
  isLost         Boolean  @default(false) @map("is_lost")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, order])
  @@index([organizationId])
  @@map("pipeline_stages")
}

model Deal {
  id                String     @id @default(cuid())
  organizationId    String     @map("organization_id")
  ownerId           String     @map("owner_id")
  contactId         String     @map("contact_id")
  companyId         String?    @map("company_id")
  pipelineStageId   String     @map("pipeline_stage_id")
  title             String
  value             Decimal    @db.Decimal(12, 2)
  status            DealStatus @default(OPEN)
  expectedCloseDate DateTime?  @map("expected_close_date")
  closedAt          DateTime?  @map("closed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)

  activities Activity[]
  tasks      Task[]

  @@index([organizationId, ownerId])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, status])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, contactId])
  @@map("deals")
}

// ─────────────────────────────────────────────
// Activities
// ─────────────────────────────────────────────

model Activity {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  contactId      String?      @map("contact_id")
  dealId         String?      @map("deal_id")
  type           ActivityType
  content        String
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ActivityAuthor", fields: [userId], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId])
  @@index([organizationId, dealId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, userId])
  @@map("activities")
}

// ─────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────

model Task {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  assigneeId        String    @map("assignee_id")
  contactId         String?   @map("contact_id")
  dealId            String?   @map("deal_id")
  title             String
  description       String?
  dueDate           DateTime  @map("due_date")
  completed         Boolean   @default(false)
  completedAt       DateTime? @map("completed_at")
  /// Set when an overdue notification job has been enqueued for this task, so
  /// the cron sweep doesn't re-notify every run; cleared when dueDate/completed
  /// change so a future overdue transition can notify again.
  overdueNotifiedAt DateTime? @map("overdue_notified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, assigneeId])
  @@index([organizationId, dueDate])
  @@index([organizationId, completed])
  @@index([organizationId, contactId])
  @@index([organizationId, dealId])
  @@map("tasks")
}
